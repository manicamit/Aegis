# AEGIS Environment Configuration
# Copy to .env and fill in your values. NEVER commit .env to git.

# API Security
SECRET_KEY=CHANGE_ME_generate_with_python_c_import_secrets_print_secrets_token_hex_32
API_KEY_HASH=
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# LLM Provider for STR Narrative (P7)
# Options: "anthropic", "openai", "ollama", "template"
LLM_PROVIDER=template
# Anthropic
ANTHROPIC_API_KEY=sk-ant-...
# OpenAI-compatible (also works for local LLMs with OpenAI-compatible API)
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o
# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3

# Model paths
MODEL_DIR=models/saved
DATA_DIR=data/processed

# Audit logging
AUDIT_LOG_PATH=logs/audit.jsonl
LOG_LEVEL=INFO

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
